FROM golang:1.21-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o media-gateway ./services/media-gateway

FROM alpine:3.18
RUN apk add --no-cache libstdc++
COPY --from=build /app/media-gateway /usr/local/bin/media-gateway
COPY sfu/mediasoup-worker/build/mediasoup-worker /usr/local/bin/mediasoup-worker
EXPOSE 9090 40000-49999/udp
ENTRYPOINT ["media-gateway"]
